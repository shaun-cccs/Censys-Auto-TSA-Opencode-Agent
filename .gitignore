# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Local rate-limit / credit state
.censys_query_rate_state.json

# Query output artifacts
results.json
*.out.json

# Secrets - tokens come from the environment, never files
.env
*.token

# Created by install.sh only when the kit lives OUTSIDE ~/.config/opencode:
# a symlink to the config dir's node_modules, so the plugin's
# `@opencode-ai/plugin` import resolves from the kit's real path.
# See install.sh for why this is necessary.
/node_modules

# Reports are written to ./reports/ in whatever directory a TSA is run from,
# which for a contributor is this repo. They are somebody's output, not part of
# the kit.
/reports/
