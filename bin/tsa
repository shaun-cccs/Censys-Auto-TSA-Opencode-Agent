#!/bin/sh
#
#  tsa - the single entrypoint to the Censys TSA kit.
#
#  WHY THIS EXISTS
#  ---------------
#  The agents in this kit run inside *the user's* project, not inside the kit.
#  So `python utils/censys_tsa.py` - which is what the prompts used to say -
#  cannot work: the cwd is wrong, and on many machines there is no `python` on
#  PATH at all. Baking absolute paths into the prompts instead would be worse:
#  the install location would be frozen, and reading kit files from under
#  ~/.config would trip opencode's external-directory permission boundary.
#
#  Everything therefore goes through this one command, which is symlinked onto
#  PATH and finds the kit by resolving its own $0 through that symlink. No
#  environment variable, no hardcoded path, nothing for the agent to get wrong.
#  Agent prompts and references contain no filesystem paths at all - `tsa ref`
#  and `tsa doc` exist so that even reading this kit's own documentation needs
#  no path.
#
#  PYTHON
#  ------
#  Dependencies are managed by uv against ../pyproject.toml + ../uv.lock. Only
#  the subcommands that talk to Censys need them; `cve`, `report` and `run` are
#  standard-library-only on purpose and run under bare python3, so a report can
#  still be rendered on a machine with no uv and no SDK.
#
#  Set CENSYS_TSA_PYTHON to an interpreter that already has censys-platform
#  installed to bypass uv entirely (air-gapped installs).
#
#  POSIX sh on purpose: macOS ships bash 3.2, and this must not care.

set -eu

# ---------------------------------------------------------------- self-location

self=$0
# Follow the symlink chain by hand. `readlink -f` is not portable to macOS
# before Monterey, and `realpath` is not guaranteed either.
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname "$self")/$target ;;
    esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
KIT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)

UTILS="$KIT/utils"
REFERENCES="$KIT/references"
DOCS="$KIT/docs"

die() {
    printf 'tsa: %s\n' "$1" >&2
    exit "${2:-1}"
}

# ------------------------------------------------------------------ interpreters

find_uv() {
    if [ -n "${CENSYS_TSA_UV:-}" ]; then
        printf '%s\n' "$CENSYS_TSA_UV"
        return 0
    fi
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return 0
    fi
    # uv's own installer puts it in ~/.local/bin, which is not always on PATH
    # in non-interactive shells - which is exactly how agents invoke us.
    for candidate in \
        "$HOME/.local/bin/uv" \
        "$HOME/.cargo/bin/uv" \
        /usr/local/bin/uv \
        /opt/homebrew/bin/uv
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

no_uv() {
    die "uv is required for this subcommand but was not found.

Install it:
    curl -LsSf https://astral.sh/uv/install.sh | sh

Then run:
    $KIT/install.sh

Or, if you already have an interpreter with censys-platform installed, set
CENSYS_TSA_PYTHON to it and uv will not be used at all." 127
}

find_python() {
    if [ -n "${CENSYS_TSA_PYTHON:-}" ]; then
        printf '%s\n' "$CENSYS_TSA_PYTHON"
        return 0
    fi
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

# Run a script that needs the Censys SDK.
run_dep() {
    script=$1
    shift
    # So argparse prints "usage: tsa assess ..." rather than naming a file the
    # user has no path to.
    CENSYS_TSA_PROG="tsa $command"
    export CENSYS_TSA_PROG
    if [ -n "${CENSYS_TSA_PYTHON:-}" ]; then
        exec "$CENSYS_TSA_PYTHON" "$UTILS/$script" "$@"
    fi
    uv=$(find_uv) || no_uv
    # --project, never --directory: --directory would chdir and silently break
    # relative output paths like `-o reports/foo.md`.
    exec "$uv" run --project "$KIT" --quiet python "$UTILS/$script" "$@"
}

# Run a standard-library-only script. No uv, no venv, no network.
run_stdlib() {
    script=$1
    shift
    CENSYS_TSA_PROG="tsa $command"
    export CENSYS_TSA_PROG
    py=$(find_python) || die "no python3 on PATH (set CENSYS_TSA_PYTHON)" 127
    exec "$py" "$UTILS/$script" "$@"
}

# --------------------------------------------------------------- ref (prose)

cmd_ref() {
    if [ $# -eq 0 ]; then
        printf 'Workflow references (use: tsa ref <name> [--brief])\n\n'
        for f in "$REFERENCES"/*.md; do
            name=$(basename "$f" .md)
            printf '  %-24s %s\n' "$name" "$(sed -n 's/^# //p' "$f" | head -1)"
        done
        printf '\n--brief prints just the quick card: the procedure and the commands,\n'
        printf 'without the worked cases. Start there; read the full text when a step\n'
        printf 'is ambiguous or a judgement call needs its rationale.\n'
        return 0
    fi
    name=$1
    shift
    file="$REFERENCES/$name.md"
    [ -f "$file" ] || die "no such reference: $name (try: tsa ref)"

    case ${1:-} in
        --brief | -b)
            #  A worker with one hypothesis to test does not need 25KB of worked
            #  cases in its context on every subsequent turn - it needs the
            #  procedure and the commands. The full text stays one call away.
            brief=$(awk '
                /^## Quick card/ { inside=1; print; next }
                inside && /^## / { exit }
                inside { print }
            ' "$file")
            if [ -n "$brief" ]; then
                printf '%s\n' "$brief"
                printf '\nFull reference: tsa ref %s\n' "$name"
            else
                #  No card written yet: print everything rather than nothing.
                printf 'tsa: %s has no quick card; printing it in full\n\n' "$name" >&2
                cat "$file"
            fi
            ;;
        "") cat "$file" ;;
        *) die "unexpected argument: ${1} (only --brief is supported)" ;;
    esac
}

# --------------------------------------------------------------- doc (CenQL)

doc_path() {
    case $1 in
        cenql | query | query-language) printf '%s\n' "$DOCS/censys_query_language.md" ;;
        regex) printf '%s\n' "$DOCS/censys_regex_language.md" ;;
        host) printf '%s\n' "$DOCS/queryable_fields/host_censys_queryable_fields.md" ;;
        web) printf '%s\n' "$DOCS/queryable_fields/web_censys_queryable_fields.md" ;;
        cert | certificate) printf '%s\n' "$DOCS/queryable_fields/certificate_censys_queryable_fields.md" ;;
        misc | tags) printf '%s\n' "$DOCS/queryable_fields/misc_censys_queryable_fields.md" ;;
        *) return 1 ;;
    esac
}

cmd_doc() {
    if [ $# -eq 0 ]; then
        cat <<'EOF'
Query-language documentation (use: tsa doc <name> [--grep PATTERN])

  cenql    CenQL syntax reference. Read before writing any query.
  regex    CenQL regex reference: escaping, anchors, operators, credit cost.
  host     Host fields. Counts always come from host queries.
  web      Web property fields. Pivots only.
  cert     Certificate fields. Pivots only.
  misc     Tag fields. Pivots only.

The field files are large. Prefer --grep over printing them whole:
  tsa doc host --grep favicon
EOF
        return 0
    fi
    name=$1
    shift
    file=$(doc_path "$name") || die "no such doc: $name (try: tsa doc)"
    if [ $# -eq 0 ]; then
        cat "$file"
        return 0
    fi
    case $1 in
        --grep | -g)
            shift
            [ $# -gt 0 ] || die "--grep needs a pattern"
            # Non-zero exit on no match is information, not failure.
            grep -n -i -E -- "$1" "$file" || {
                printf 'no match for %s in %s\n' "$1" "$(basename "$file")" >&2
                return 1
            }
            ;;
        *) die "unexpected argument: $1 (only --grep PATTERN is supported)" ;;
    esac
}

# --------------------------------------------------------------------- doctor

cmd_doctor() {
    exec "$KIT/install.sh" --doctor "$@"
}

# --------------------------------------------------------------------- version

cmd_version() {
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$KIT/pyproject.toml" | head -1)
    printf 'censys-tsa-kit %s\n' "${version:-unknown}"
    printf 'kit  %s\n' "$KIT"
    if command -v git >/dev/null 2>&1 && [ -d "$KIT/.git" ]; then
        rev=$(git -C "$KIT" rev-parse --short HEAD 2>/dev/null || true)
        [ -n "$rev" ] && printf 'rev  %s\n' "$rev"
    fi
}

# ----------------------------------------------------------------------- usage

usage() {
    cat <<'EOF'
tsa - Censys Threat Surface Assessment toolkit

Censys queries (need uv + the censys-platform SDK, cost credits):
  tsa assess <query> [--cve ID] [--product NAME] [--country C]
                          Global + country host counts for a base query. 2 credits.
  tsa search <query> [--max-results N] [--format table|json]
                          Rate-limited host search. Validation and pivots. 1 credit.
  tsa agg <field> <query> [-k N] [--count-hosts] [--compare-levels]
                          Bucket a field across a query. The fingerprint tool. 1 credit.
  tsa probe <seed> [--wide]
                          Step 1 in ONE call: full-text sample plus the product
                          bucket in all three tag trees. 4 credits (9 with --wide).
  tsa candidates <base> <cand>... [--totals]
                          Step 8b in ONE call: incremental hosts each candidate
                          adds over the base, with the titles of those hosts.
                          1 + 2 per candidate.
  tsa batch [--count Q]... [--sample Q]... [--agg FIELD Q]... [-p plan.json]
                          Any set of independent calls, run together. 1 each.
  tsa credits balance | usage [--granularity daily|monthly]
                          Credit balance and usage. Free.
  tsa budget              Session credit ledger state. Free.

Offline (standard library only, no uv, no credits):
  tsa limits [none|fast|standard|clear]
                          How fast this machine may issue Censys requests. No
                          argument shows what is in force and where it came from.
  tsa timeline [--since S] [--all] [-f json]
                          Where a run's wall-clock time went: time inside Censys
                          versus idle gap. Read this before optimising anything.
  tsa cve <CVE-ID> [--single] [-f json]
                          Retrieve a CVE record from cve.org, falling back to NVD.
  tsa report --template   Print the report spec schema.
  tsa report <spec.json> -o <out.md>
                          Render a spec as a markdown report.
  tsa run <target> [--cve ID] [--deep-dive] [--allow-web] [--budget N]
                          Unattended TSA. Drives the censys-tsa-auto agent and
                          writes ./reports/<slug>.spec.json in the current dir.

Documentation, shipped with the kit:
  tsa ref [name] [--brief]
                          Workflow references. No argument lists them; --brief
                          prints just the procedure and the commands.
  tsa doc [name] [--grep PATTERN]
                          CenQL and queryable-field docs. No argument lists them.

Housekeeping:
  tsa doctor              Check the install: uv, venv, token, links, plugin.
  tsa install [--help]    (Re)install into ~/.config/opencode. Idempotent.
  tsa uninstall           Remove what install created. Touches nothing else.
  tsa home                Print the kit directory.
  tsa version

Environment:
  CENSYS_PERSONAL_ACCESS_TOKEN  required for every Censys call
  CENSYS_ORG_ID                 required; your Censys Platform organization
  CENSYS_TSA_PYTHON             interpreter that already has censys-platform;
                                set it to bypass uv entirely
  CENSYS_TSA_UV                 explicit path to the uv binary
EOF
}

# -------------------------------------------------------------------- dispatch

[ $# -gt 0 ] || { usage; exit 0; }

command=$1
shift

case $command in
    assess) run_dep censys_tsa.py "$@" ;;
    search) run_dep censys_query.py "$@" ;;
    agg | aggregate) run_dep censys_aggregate.py "$@" ;;
    batch) run_dep censys_batch.py batch "$@" ;;
    probe) run_dep censys_batch.py probe "$@" ;;
    candidates) run_dep censys_batch.py candidates "$@" ;;
    credits) run_dep censys_credits.py "$@" ;;
    budget) run_dep censys_session_budget.py "$@" ;;
    timeline) run_stdlib censys_metrics.py "$@" ;;
    limits) run_stdlib censys_limits.py "$@" ;;
    cve) run_stdlib cve_lookup.py "$@" ;;
    report) run_stdlib tsa_report.py "$@" ;;
    run) run_stdlib tsa_run.py "$@" ;;
    ref) cmd_ref "$@" ;;
    doc | docs) cmd_doc "$@" ;;
    doctor) cmd_doctor "$@" ;;
    install) exec "$KIT/install.sh" "$@" ;;
    uninstall) exec "$KIT/install.sh" --uninstall "$@" ;;
    home) printf '%s\n' "$KIT" ;;
    version | --version | -V) cmd_version ;;
    help | --help | -h) usage ;;
    *) die "unknown subcommand: $command (try: tsa help)" 64 ;;
esac
